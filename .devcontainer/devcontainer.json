{
  "name": "crosschain-sdlc-demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "frontend" },
    "8000": { "label": "backend" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss", "JuanBlanco.solidity"]
    }
  }
}
